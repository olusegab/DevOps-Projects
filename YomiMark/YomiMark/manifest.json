{
  "manifest_version": 3,
  "name": "YomiMark",
  "version": "4.0.0",
  "description": "Enterprise bookmark manager — persistent window, full keyboard support.",
  "permissions": ["bookmarks", "tabs", "storage", "windows"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open YomiMark",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
